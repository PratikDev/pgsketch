{
  "name": "@pgsketch/desktop",
  "version": "0.1.0",
  "description": "Edit a Postgres schema on a canvas and generate the migration SQL",
  "homepage": "https://github.com/PratikDev/pgsketch",
  "author": "Pratik Dev <pratikdevofficial1@gmail.com>",
  "desktopName": "pgsketch.desktop",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "pnpm typecheck && electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "postinstall": "install-electron",
    "test": "vitest run --project renderer --project main",
    "test:db": "vitest run --project db",
    "test:e2e": "electron-vite build && playwright test",
    "package": "pnpm build && electron-builder --linux deb"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "pg": "8.23.1",
    "pg-connection-string": "2.14.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/geist": "^5.3.0",
    "@pgsketch/core": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@testcontainers/postgresql": "^12.2.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "elkjs": "^0.12.0",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  }
}
