{
  "name": "pgsketch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "pnpm --filter @pgsketch/desktop dev",
    "dev:tmp": "PGSKETCH_DATA_DIR=$(mktemp -d) pnpm --filter @pgsketch/desktop dev",
    "db:up": "apps/desktop/scripts/dev-db.sh up",
    "db:load": "apps/desktop/scripts/dev-db.sh load",
    "db:setup": "pnpm db:up && pnpm db:load",
    "db:down": "apps/desktop/scripts/dev-db.sh down",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
